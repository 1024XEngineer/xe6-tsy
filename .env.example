APP_ENV=local

API_ADDR=:8080
REALTIME_ADDR=:8090

DATABASE_URL=postgres://postgres:postgres@localhost:5432/lingow?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=local-dev-only-secret-change-me-1234

ASR_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# Qwen provider configuration reference. Construct adapters explicitly; uncommenting this file alone does not switch runtime providers.
# ASR_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ASR_WEBSOCKET_URL=
# ASR_MODEL=qwen3-asr-flash-realtime
# ASR_API_KEY=
# ASR_SAMPLE_RATE=16000
# ASR_VAD_THRESHOLD=0.0
# ASR_SILENCE_DURATION_MS=500
# LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-flash
# LLM_API_KEY=
# LLM_ENABLE_THINKING=false
# LLM_TIMEOUT_MS=15000
# TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# TTS_MODEL=qwen3-tts-flash
# TTS_API_KEY=
# TTS_VOICE=Cherry
