APP_ENV=local

API_ADDR=:8080
REALTIME_ADDR=:8090
# Session production runtime is disabled until a deployable realtime-audio
# control-plane service is available.
LINGOW_SESSION_RUNTIME=disabled

# Required only when LINGOW_SESSION_RUNTIME=enabled.
REALTIME_BASE_URL=http://127.0.0.1:8090
REALTIME_TICKET_SECRET=
REALTIME_HTTP_TIMEOUT=5s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/lingow?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Delivery runtime is opt-in. Keep disabled when infrastructure is absent.
LINGOW_DELIVERY_RUNTIME=disabled
JWT_ISSUER=lingow-api
JWT_AUDIENCE=lingow-client
LINGOW_DELIVERY_PROVIDER=unconfigured
# Use smtp for production email delivery; fake_email is local/test only.
#LINGOW_DELIVERY_PROVIDER=smtp
#LINGOW_SMTP_HOST=localhost
#LINGOW_SMTP_PORT=1025
#LINGOW_SMTP_FROM=noreply@example.test
#LINGOW_WECOM_CORP_ID=
#LINGOW_WECOM_CORP_SECRET=
#LINGOW_WECOM_AGENT_ID=
# Required only when LINGOW_DELIVERY_RUNTIME=enabled; use a base64url-encoded 32-byte key.
LINGOW_DELIVERY_DESTINATION_KEY=
LINGOW_DELIVERY_CONSUMER=api-local
LINGOW_DELIVERY_STREAM=lingow:delivery
LINGOW_DELIVERY_GROUP=lingow-delivery
LINGOW_DELIVERY_DELAY_STREAM=lingow:delivery:delayed
LINGOW_DELIVERY_DELAY_KEY=lingow:delivery:delay
LINGOW_USAGE_STREAM=lingow:usage:recorded
LINGOW_USAGE_GROUP=lingow-usage
LINGOW_USAGE_CONSUMER=api-local-usage

JWT_SECRET=local-dev-only-secret-change-me-1234
AUTH_PEPPER=local-dev-only-pepper-change-me-123456
VERIFICATION_SENDER=log
VERIFICATION_UNIVERSAL_CODE=8888

ASR_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# Local demo language pair (realtime StaticLanguageConfigReader + ASR source).
# REALTIME_SOURCE_LANGUAGE=zh-CN
# REALTIME_TARGET_LANGUAGE=en-US

# Browser TTS downlink for realtime-audio local entrypoint.
# none (default): SkipTTSTrack — subtitles only, Chrome-safe.
#   In subtitle-only mode the entrypoint forces TTS_PROVIDER=mock so Aliyun TTS
#   cannot fail the session after subtitles are published.
# opus: attach an Opus send track; then real TTS_PROVIDER=aliyun is used.
# REALTIME_TTS_DOWNLINK=none

# Local energy VAD owns utterance cuts. Leave unset (entrypoint disables Qwen
# server_vad) or set explicitly:
# ASR_SERVER_VAD=false

# To use real Aliyun/Qwen for ASR+LLM (subtitle-only, recommended first):
#   1. Set ASR_PROVIDER=aliyun LLM_PROVIDER=aliyun
#   2. Leave REALTIME_TTS_DOWNLINK unset/none (TTS stays mock automatically)
#   3. Fill the keys/URLs below
#   4. Restart via start-local.bat (go run does not auto-load .env)

# Qwen provider configuration reference. Construct adapters explicitly; uncommenting this file alone does not switch runtime providers.
# ASR_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ASR_WEBSOCKET_URL=
# ASR_MODEL=qwen3-asr-flash-realtime
# ASR_API_KEY=
# ASR_SAMPLE_RATE=16000
# ASR_VAD_THRESHOLD=0.0
# ASR_SILENCE_DURATION_MS=500
# LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-flash
# LLM_API_KEY=
# LLM_ENABLE_THINKING=false
# LLM_TIMEOUT_MS=15000
# TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# TTS_MODEL=qwen3-tts-flash
# TTS_API_KEY=
# TTS_VOICE=Cherry
# TTS_SAMPLE_RATE=24000
# TTS_TIMEOUT_MS=30000
