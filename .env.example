APP_ENV=local

API_ADDR=:8080
REALTIME_ADDR=:8090
# Session production runtime is disabled until a deployable realtime-audio
# control-plane service is available.
LINGOW_SESSION_RUNTIME=disabled

# Required only when LINGOW_SESSION_RUNTIME=enabled.
REALTIME_BASE_URL=http://127.0.0.1:8090
REALTIME_TICKET_SECRET=
REALTIME_HTTP_TIMEOUT=5s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/lingow?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REALTIME_REDIS_MODE=standalone

# Delivery runtime is opt-in. Keep disabled when infrastructure is absent.
LINGOW_DELIVERY_RUNTIME=disabled
JWT_ISSUER=lingow-api
JWT_AUDIENCE=lingow-client
LINGOW_DELIVERY_PROVIDER=unconfigured
# Use smtp for production email delivery; fake_email is local/test only.
#LINGOW_DELIVERY_PROVIDER=smtp
#LINGOW_SMTP_HOST=localhost
#LINGOW_SMTP_PORT=1025
#LINGOW_SMTP_FROM=noreply@example.test
#LINGOW_WECOM_CORP_ID=
#LINGOW_WECOM_CORP_SECRET=
#LINGOW_WECOM_AGENT_ID=
# Required only when LINGOW_DELIVERY_RUNTIME=enabled; use a base64url-encoded 32-byte key.
LINGOW_DELIVERY_DESTINATION_KEY=
LINGOW_DELIVERY_CONSUMER=api-local
LINGOW_DELIVERY_STREAM=lingow:delivery
LINGOW_DELIVERY_GROUP=lingow-delivery
LINGOW_DELIVERY_DELAY_STREAM=lingow:delivery:delayed
LINGOW_DELIVERY_DELAY_KEY=lingow:delivery:delay
LINGOW_USAGE_STREAM=lingow:usage:recorded
LINGOW_USAGE_GROUP=lingow-usage
LINGOW_USAGE_CONSUMER=api-local-usage
LINGOW_MODE_CHANGED_STREAM=lingow:realtime:mode:changed
LINGOW_MODE_CHANGED_GROUP=lingow-mode-projection
LINGOW_MODE_CHANGED_CONSUMER=api-local-mode

JWT_SECRET=local-dev-only-secret-change-me-1234
AUTH_PEPPER=local-dev-only-pepper-change-me-123456
VERIFICATION_SENDER=log
VERIFICATION_UNIVERSAL_CODE=8888

# Internal bearer credential for the records PATCH routes. When empty, the API
# still starts but both PATCH routes fail closed (forbidden). Use at least 32 bytes.
# LINGOW_RECORDS_SYSTEM_TOKEN=
#
# Async speaker attribution: pending/provisional final turns are enqueued as durable
# tasks regardless, but the attribution worker only produces real results for turns that
# carry a provider speaker key (upstream diarization). Without a key the task fails with
# no_provider_speaker_id instead of being silently acked. Both API runtimes start the
# worker; no extra token is required for the in-process path.

ASR_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# Link realtime to the API Postgres (same DATABASE_URL): session ownership,
# active language_pairs, speakers attribution, and FinalTurn → final_turn_outbox.
# REALTIME_API_DATABASE=enabled

# Persist usage.recorded and realtime.mode.changed into Redis/Valkey streams.
# Requires REDIS_URL. The API consumes mode changes when LINGOW_SESSION_RUNTIME is enabled.
# REALTIME_OUTBOX=valkey

# Fallback language pair when API DB link is off or no active config exists.
# REALTIME_SOURCE_LANGUAGE=zh-CN
# REALTIME_TARGET_LANGUAGE=en-US

# Browser TTS downlink for realtime-audio local entrypoint.
# none (default): subtitles only; forces TTS_PROVIDER=mock.
# pcm: real TTS PCM over DataChannel (recommended for hearing translations in Chrome).
# opus: WebRTC Opus send track (encoder still stub until PCM→Opus lands).
# REALTIME_TTS_DOWNLINK=pcm

# Semantic voice commands are opened by client-side KWS and interpreted by
# realtime-audio. Web uses sherpa-onnx; devices such as ESP32-S3 may use their
# own onboard KWS model. The backend does not load or configure KWS models.
# COMMAND_INTERPRETER=qwen
# COMMAND_LLM_API_KEY=
# COMMAND_LLM_BASE_URL=
# COMMAND_LLM_MODEL=qwen3.6-flash
# COMMAND_LLM_TIMEOUT_MS=10000
#
# Required together when COMMAND_INTERPRETER=qwen. Configure the same random
# token (at least 32 bytes) in services/api and services/realtime-audio.
# LINGOW_API_BASE_URL=http://127.0.0.1:8080
# LINGOW_COMMAND_SYSTEM_TOKEN=
# COMMAND_CONFIG_TIMEOUT_MS=3000

# Local utterance VAD defaults to Silero. First Windows start auto-downloads ONNX Runtime.
# LOCAL_VAD_PROVIDER=energy
# ASR_SERVER_VAD=false

# To use real Aliyun/Qwen for ASR+LLM (subtitle-only, recommended first):
#   1. Set ASR_PROVIDER=aliyun LLM_PROVIDER=aliyun
#   2. Leave REALTIME_TTS_DOWNLINK unset/none (TTS stays mock automatically)
#   3. Fill the keys/URLs below
#   4. Restart via start-local.bat (go run does not auto-load .env)

# Qwen provider configuration reference. Construct adapters explicitly; uncommenting this file alone does not switch runtime providers.
# ASR_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ASR_WEBSOCKET_URL=
# ASR_MODEL=qwen3-asr-flash-realtime
# ASR_API_KEY=
# ASR_SAMPLE_RATE=16000
# ASR_VAD_THRESHOLD=0.0
# ASR_SILENCE_DURATION_MS=500
# LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-flash
# LLM_API_KEY=
# LLM_ENABLE_THINKING=false
# LLM_TIMEOUT_MS=15000
# TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# TTS_MODEL=qwen3-tts-flash
# TTS_API_KEY=
# TTS_VOICE=Cherry
# For multilingual TTS, use a compatible CosyVoice voice:
# TTS_MODEL=cosyvoice-v3.5-flash
# TTS_VOICE=your_designed_voice_id
# TTS_SAMPLE_RATE=24000
# TTS_TIMEOUT_MS=30000
