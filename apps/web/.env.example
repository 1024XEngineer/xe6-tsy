# xe6-tsy API (Next rewrites /api/v1 → this host)
LINGOW_API_BASE_URL=http://127.0.0.1:8080

# xe6-tsy realtime control-plane (Next rewrites /realtime/v1 → this host)
LINGOW_REALTIME_BASE_URL=http://127.0.0.1:8090

# Optional local-only bypass for /api/dev/realtime-ticket (disabled by default).
# Prefer POST /api/v1/voice-sessions/{id}/realtime-ticket.
# ENABLE_DEV_REALTIME_TICKET=true
# REALTIME_TICKET_SECRET=replace-with-at-least-32-byte-secret!!
