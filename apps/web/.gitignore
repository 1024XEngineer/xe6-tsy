# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# backend
backend/.venv/
backend/.env
backend/wechat-settings.local.json
logs/
.backend.pid
.web.pid

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sherpa-onnx KWS model weights / WASM binary (sync via pnpm run sync-kws-models)
/public/kws/*.onnx
/public/kws/wasm/*.wasm
