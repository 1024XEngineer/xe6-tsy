# Image names are generated by the deployment workflow. Keep immutable SHA tags.
LINGOW_API_IMAGE=ghcr.io/<GitHub owner>/lingow-api:<commit SHA>
LINGOW_REALTIME_AUDIO_IMAGE=ghcr.io/<GitHub owner>/lingow-realtime-audio:<commit SHA>
LINGOW_WEB_IMAGE=ghcr.io/<GitHub owner>/lingow-web:<commit SHA>

# Managed PostgreSQL and Redis/Valkey endpoints reachable from the deployment host.
DATABASE_URL=<PostgreSQL connection URL>
REDIS_URL=<Redis or Valkey connection URL>

# Generate independent secrets with at least 32 random bytes each.
JWT_SECRET=<random JWT secret, at least 32 bytes>
AUTH_PEPPER=<random auth pepper, at least 32 bytes>
REALTIME_TICKET_SECRET=<random realtime ticket secret, at least 32 bytes>
LINGOW_DELIVERY_DESTINATION_KEY=<base64url delivery encryption key>
LINGOW_RECORDS_SYSTEM_TOKEN=<records system authentication token>
LINGOW_COMMAND_SYSTEM_TOKEN=<command system authentication token>

# Every consumer name must be unique per API replica.
LINGOW_DELIVERY_CONSUMER=<unique delivery consumer name>
LINGOW_USAGE_CONSUMER=<unique usage consumer name>
LINGOW_MODE_CHANGED_CONSUMER=<unique mode projection consumer name>

# Production delivery and verification provider settings.
VERIFICATION_SENDER=<verification sender mode>
LINGOW_DELIVERY_PROVIDER=smtp
LINGOW_SMTP_HOST=<SMTP server host>
LINGOW_SMTP_PORT=587
LINGOW_SMTP_USER=<SMTP username>
LINGOW_SMTP_PASSWORD=<SMTP password>
LINGOW_SMTP_FROM=<verified sender email address>
LINGOW_SMTP_TLS=true
LINGOW_WECOM_CORP_ID=<WeCom corporation ID>
LINGOW_WECOM_CORP_SECRET=<WeCom corporation secret>
LINGOW_WECOM_AGENT_ID=<WeCom application agent ID>

# Realtime providers. Use mock only for an isolated non-production environment.
ASR_PROVIDER=aliyun
ASR_BASE_URL=<ASR provider base URL>
ASR_WEBSOCKET_URL=<ASR realtime WebSocket URL>
ASR_MODEL=qwen3-asr-flash-realtime
ASR_API_KEY=<ASR provider API key>
LLM_PROVIDER=aliyun
LLM_BASE_URL=<LLM provider base URL>
LLM_MODEL=qwen3.6-flash
LLM_API_KEY=<LLM provider API key>
TTS_PROVIDER=aliyun
TTS_BASE_URL=<TTS provider base URL>
TTS_MODEL=qwen3-tts-flash
TTS_API_KEY=<TTS provider API key>
TTS_VOICE=<TTS voice identifier>
COMMAND_INTERPRETER=qwen
COMMAND_LLM_API_KEY=<command interpreter API key>
COMMAND_LLM_BASE_URL=<command interpreter base URL>
COMMAND_LLM_MODEL=qwen3.6-flash

WEB_BIND_IP=127.0.0.1
WEB_PORT=3000
